repositories:
  # Trỏ tất cả vào branch x500_model của fork — khớp với .gitmodules.
  # Repo file này được giữ lại làm tài liệu tham khảo; việc checkout thực tế
  # thực hiện bằng `git submodule` (.gitmodules), không dùng vcs import nữa.
  ardupilot:
    type: git
    url: https://github.com/NguyenAn20279/ardupilot.git
    version: x500_model

  ardupilot_gazebo:
    type: git
    url: https://github.com/NguyenAn20279/ardupilot_gazebo.git
    version: x500_model

  ardupilot_gz:
    type: git
    url: https://github.com/NguyenAn20279/ardupilot_gz.git
    version: x500_model

  ardupilot_sitl_models:
    type: git
    url: https://github.com/NguyenAn20279/SITL_Models.git
    version: x500_model

  micro_ros_agent:
    type: git
    url: https://github.com/NguyenAn20279/micro-ROS-Agent.git
    version: x500_model

  ros_gz:
    type: git
    url: https://github.com/NguyenAn20279/ros_gz.git
    version: x500_model

  sdformat_urdf:
    type: git
    url: https://github.com/NguyenAn20279/sdformat_urdf.git
    version: x500_model
