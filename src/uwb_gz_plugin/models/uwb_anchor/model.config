<?xml version="1.0"?>
<model>
  <name>uwb_anchor</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>AerialVehicleControl</name>
    <email>an@todo.todo</email>
  </author>
  <description>
    Static UWB anchor. Four of these are placed in the runway world in a
    10x10 m square, with z=2.0 m. The UWB plugin discovers them by their
    name prefix "uwb_anchor".
  </description>
</model>
