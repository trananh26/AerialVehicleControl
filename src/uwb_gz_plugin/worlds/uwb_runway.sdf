<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="uwb_runway">
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <!-- NOTE: no gz-sim-pose-publisher-system here.  That system has to be
         attached to a model entity; at the world level Gazebo rejects it
         with "PosePublisher plugin should be attached to a model entity"
         and it never initialises.  It is not needed anyway: the UWB plugin
         reads the WorldPose component that the Physics system writes for
         dynamic entities, and falls back to walking the parent chain. -->
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure">
    </plugin>
    <plugin filename="gz-sim-air-speed-system"
            name="gz::sim::systems::AirSpeed">
    </plugin>
    <plugin filename="gz-sim-altimeter-system"
            name="gz::sim::systems::Altimeter">
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat">
    </plugin>

    <!-- The UWB System is attached to the world so it ticks every step. -->
    <plugin filename="uwb_gz_plugin"
            name="uwb_gz_plugin::systems::UwbSystem">
      <update_rate>20.0</update_rate>
      <tag_id>0</tag_id>
      <tag_model_name>x500</tag_model_name>
      <tag_link>base_link</tag_link>
      <all_los>true</all_los>
      <max_range>50.0</max_range>
      <los_std>0.05</los_std>

      <!-- Anchor positions in the Gazebo world frame, metres.
           These must match the <include> poses below.  The four anchors sit
           on the corners of a rectangle at z = 2.0 m.

           The Gazebo world frame is ENU (x = East, y = North, z = Up),
           while the anchor frame used by the solver is NED-ish
           (x = North, y = East, z = Down).  With the default layout angle
           alpha = 0 the two differ by the usual axis swap, so for the
           default 10 m x 10 m layout:

             anchor frame a0 = (N 0,  E 0)  ->  ENU (E 0,  N 0)
             anchor frame a1 = (N 10, E 0)  ->  ENU (E 0,  N 10)
             anchor frame a2 = (N 10, E 10) ->  ENU (E 10, N 10)
             anchor frame a3 = (N 0,  E 10) ->  ENU (E 10, N 0)

           The launch file rewrites these positions when the layout is not
           the default one; see uwb_pozyx_bridge/uwb_world.py.

           Note: the plugin reads <pos> as a child element, not an attribute. -->
      <anchor name="uwb_anchor0"><pos>0 0 2.0</pos></anchor>
      <anchor name="uwb_anchor1"><pos>0 10 2.0</pos></anchor>
      <anchor name="uwb_anchor2"><pos>10 10 2.0</pos></anchor>
      <anchor name="uwb_anchor3"><pos>10 0 2.0</pos></anchor>
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <spherical_coordinates>
      <latitude_deg>-35.3632621</latitude_deg>
      <longitude_deg>149.1652374</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <include>
      <uri>model://runway</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <!-- 4 static UWB anchors on the corners of a rectangle (10 m x 10 m by
         default).  These are the Gazebo world (ENU) positions, and they
         match the <anchor> elements of the UWB plugin above:

           a0 = (E  0, N  0)      a1 = (E  0, N 10)
           a3 = (E 10, N  0)      a2 = (E 10, N 10)

         In the anchor frame used by the solver (x = North, y = East) this
         is the ideal rectangle a0 = (0,0), a1 = (X,0), a2 = (X,Y),
         a3 = (0,Y).  The launch file rewrites these poses when the layout
         is not the default one. -->
    <include>
      <uri>model://uwb_anchor</uri>
      <name>uwb_anchor0</name>
      <pose>0 0 2.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://uwb_anchor</uri>
      <name>uwb_anchor1</name>
      <pose>0 10 2.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://uwb_anchor</uri>
      <name>uwb_anchor2</name>
      <pose>10 10 2.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://uwb_anchor</uri>
      <name>uwb_anchor3</name>
      <pose>10 0 2.0 0 0 0</pose>
    </include>

    <!-- NOTE: the x500 model is spawned at runtime by ros_gz_sim create
         (see x500_uwb.launch.py) so we do NOT include it here.  Doing
         otherwise would create a duplicate.  Position the robot via the
         x= / y= / z= launch arguments. -->

  </world>
</sdf>
