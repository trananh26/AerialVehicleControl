<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uwb_bridge</name>
  <version>0.1.0</version>
  <description>
    Bridges UWB ranging data from the Gazebo Harmonic plugin
    (uwb_gz_plugin) into ROS 2, runs weighted least-squares
    trilateration, and publishes the resulting pose so that
    MAVROS / mavros_extras vision_pose_estimate can fuse it
    into ArduPilot's EKF.
  </description>

  <maintainer email="an@todo.todo">AerialVehicleControl</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
