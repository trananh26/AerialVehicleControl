# ArduPilot SITL parameters for the Pozyx UWB beacon pipeline.
#
# Based on ArduPilot's Tools/autotest/default_params/copter-beacon.parm, with
# BCN_TYPE changed from 10 (built-in SITL beacon simulator) to 1 (Pozyx
# backend, fed over a serial port by the Python node).
#
# NOTE: this ArduPilot build (55ae8d2825) uses the ARMING_CHECK bitmask;
# there is no ARMING_SKIPCHK parameter.  The upstream instruction
# "ARMING_SKIPCHK = 8 (skip the GPS arming check)" is therefore translated to
# ARMING_CHECK = 0xFFFFF with the "GPS lock" bit (bit 3, value 8) cleared,
# i.e. every other arming check stays enabled.

    10|# --- Beacon system ---
BCN_TYPE 1
BCN_ALT 584
BCN_LATITUDE -35.363261
BCN_LONGITUDE 149.165230
# Heading from the beacon origin anchor to the 2nd anchor, in degrees.
# The simulated anchor layout is axis aligned with north, so this is 0.
BCN_ORIENT_YAW 0

# --- EKF3: use the beacon system as the primary position source ---
EK3_ENABLE 1
EK2_ENABLE 0
EK3_SRC1_POSXY 4
EK3_SRC1_POSZ 1
EK3_SRC1_VELXY 0
EK3_SRC1_VELZ 0
EK3_SRC1_YAW 1
AHRS_EKF_TYPE 3

# --- No GPS: this is an indoor setup ---
GPS1_TYPE 0
GPS2_TYPE 0

# --- Arming: disable only the GPS lock check (upstream ARMING_SKIPCHK=8) ---
# ARMING_CHECK bits: 0 All, 1 Baro, 2 Compass, 3 GPS lock, 4 INS, 5 Params,
# 6 RC, 7 Voltage, 8 Battery, 10 Logging, 11 Safety switch, 12 GPS config,
# 13 System, 14 Mission, 15 Rangefinder, 16 Camera, 17 AuxAuth, 18 Vision,
# 19 FFT.  0xFFFFF = all of bits 0..19; clear bit 3 (GPS lock, 0x8).
ARMING_CHECK 1048567

# --- Serial port used by the Pozyx backend ---
# SerialProtocol_Beacon = 13.  Set in the defaults file so the serial port is
# opened with the beacon protocol from the very first boot; changing
# SERIALx_PROTOCOL at runtime requires the EKF to be reinitialised.
SERIAL1_PROTOCOL 13
SERIAL1_BAUD 115
# No hardware flow control on the beacon port.
BRD_SER1_RTSCTS 0
