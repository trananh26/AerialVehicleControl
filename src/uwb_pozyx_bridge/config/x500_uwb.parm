# SITL parameters for the x500 UWB + Pozyx pipeline.
#
# This is a single merged file, so SITL is started with one --defaults
# argument instead of three.  It is the concatenation of:
#
#   1. ArduPilot's Tools/autotest/default_params/copter.parm
#   2. ardupilot_gazebo/config/gazebo-x500.parm   (x500 dynamics + frame)
#   3. the Pozyx beacon settings that used to live in uwb_pozyx_bridge's
#      own config/beacon.parm
#
# Later entries win, so the order above matters: the x500 tuning overrides
# the generic copter defaults, and the beacon settings override both.
#
# The old per-file setup is still referenced by the Phase 3 verification
# script; see docs/UWB_POZYX_PIPELINE.md for the parameter rationale.

# ===========================================================================
# 1. ArduPilot default copter parameters
# ===========================================================================

FRAME_TYPE	0
FS_THR_ENABLE   1
ARSPD_PIN 1
ARSPD_BUS 2
ARMING_CHECK 1
ATC_RAT_YAW_P 0.3
ATC_RAT_YAW_I 0.02
BATT_MONITOR    4
COMPASS_OFS_X   5
COMPASS_OFS_Y   13
COMPASS_OFS_Z   -18
COMPASS_OFS2_X   5
COMPASS_OFS2_Y   13
COMPASS_OFS2_Z   -18
COMPASS_OFS3_X   5
COMPASS_OFS3_Y   13
COMPASS_OFS3_Z   -18
FENCE_RADIUS    150
FRAME_CLASS     1
RC1_MAX         2000.000000
RC1_MIN         1000.000000
RC1_TRIM        1500.000000
RC2_MAX         2000.000000
RC2_MIN         1000.000000
RC2_TRIM        1500.000000
RC3_MAX         2000.000000
RC3_MIN         1000.000000
RC3_TRIM        1500.000000
RC4_MAX         2000.000000
RC4_MIN         1000.000000
RC4_TRIM        1500.000000
RC5_MAX         2000.000000
RC5_MIN         1000.000000
RC5_TRIM        1500.000000
RC6_MAX         2000.000000
RC6_MIN         1000.000000
RC6_TRIM        1500.000000
RC7_MAX         2000.000000
RC7_MIN         1000.000000
RC7_OPTION      7
RC7_TRIM        1500.000000
RC8_MAX         2000.000000
RC8_MIN         1000.000000
RC8_TRIM        1500.000000
FLTMODE1        4
FLTMODE2        4
FLTMODE3        4
FLTMODE4        4
FLTMODE5        4
FLTMODE6		4
# All six flight mode slots point at GUIDED (4).
#
# The stock copter.parm maps them to Circle, Land, RTL, Auto, Loiter and
# Stabilise.  Two of those are not armable from a GCS (Auto) and Land
# disarms the vehicle again straight away, which made it impossible to
# command a takeoff over MAVLink.  GUIDED is armable and is the mode a
# GCS is expected to fly in, so every slot points at it.
#
# This changes the mode selected by the mode channel, not the mode
# requested with MAV_CMD_DO_SET_MODE.
SIM_BARO_RND    0
# we need small INS_ACC offsets so INS is recognised as being calibrated
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X   0.001
INS_ACC2OFFS_Y   0.001
INS_ACC2OFFS_Z   0.001
INS_ACC2SCAL_X   1.001
INS_ACC2SCAL_Y   1.001
INS_ACC2SCAL_Z   1.001
INS_ACC3OFFS_X   0.000
INS_ACC3OFFS_Y   0.000
INS_ACC3OFFS_Z   0.000
INS_ACC3SCAL_X   1.000
INS_ACC3SCAL_Y   1.000
INS_ACC3SCAL_Z   1.000
MOT_THST_EXPO   0.65
MOT_THST_HOVER  0.39
MOT_BAT_VOLT_MIN 9.6
MOT_BAT_VOLT_MAX 12.8
# flightmodes
# switch 1 Circle
# switch 2 LAND
# switch 3 RTL
# switch 4 Auto
# switch 5 Loiter
# switch 6 Stab
# STABILIZE 	0 !
# ACRO 			1
# ALT_HOLD 		2
# AUTO 			3 !
# GUIDED 		4
# LOITER 		5 !
# RTL 			6 !
# CIRCLE 		7 !
# POSITION 		8
# LAND 			9 !

# ===========================================================================
# 2. x500 vehicle tuning (from ardupilot_gazebo/config/gazebo-x500.parm)
#
# X500 is X frame quadcopter
FRAME_CLASS      1
FRAME_TYPE       1

# Match servo out for motors
MOT_PWM_MIN      1100
MOT_PWM_MAX      1900

# Use primary compass for heading (magnetometer_sensor in model)
# COMPASS_USE2/3 disabled — only one mag in x500 SDF
COMPASS_USE      1
COMPASS_USE2     0
COMPASS_USE3     0

# ── Attitude rate PIDs scaled for x500 dynamics ──────────────────────────────
# x500 vs iris analysis:
#   Roll/Pitch sensitivity: 2.09x higher  (body Ixx=0.0217 vs iris 0.0348)
#   Yaw sensitivity:        3.93x higher  (body Izz=0.040  vs iris 0.098,
#                                          and larger drag arm cp=0.1 vs 0.084)
# → All rate PID gains scaled down by the sensitivity ratio.

# Roll rate PID  (iris default 0.135/0.135/0.003  × 0.479)
ATC_RAT_RLL_P    0.065
ATC_RAT_RLL_I    0.065
ATC_RAT_RLL_D    0.0015

# Pitch rate PID  (iris default 0.135/0.135/0.003  × 0.479)
ATC_RAT_PIT_P    0.065
ATC_RAT_PIT_I    0.065
ATC_RAT_PIT_D    0.0015

# Yaw rate PID   (iris default 0.18/0.018/0.0   × 0.254)
ATC_RAT_YAW_P    0.046
ATC_RAT_YAW_I    0.0046
ATC_RAT_YAW_D    0.000

# Hover throttle: x500 needs ~48% vs iris ~42% (heavier + same motors)
MOT_THST_HOVER   0.48

# ===========================================================================
# 3. UWB positioning via MAVLink ODOMETRY (external navigation)
#
# The UWB trilateration result is sent to ArduPilot as a MAVLink ODOMETRY
# message (id 331) over SERIAL1.  ArduPilot's AP_VisualOdom backend consumes
# it and forwards the position to EKF3 as an "external navigation" (EXTNAV)
# measurement.
#
# Two upstream behaviours drive the parameter choices below:
#
# 1. GCS_MAVLINK::handle_odometry() rejects the message unless
#    frame_id == MAV_FRAME_LOCAL_FRD and child_frame_id == MAV_FRAME_BODY_FRD.
#    The companion node therefore always sends those two frames, with the
#    position expressed in NED (north/east/down) as ArduPilot expects.
#
# 2. The beacon backend is no longer used, so BCN_TYPE is disabled.  It is
#    left in the file with value 0 so that a stale value from a previous boot
#    cannot re-enable it.
#
# NOTE: this ArduPilot build (55ae8d2825) uses the ARMING_CHECK bitmask;
# there is no ARMING_SKIPCHK parameter.  The upstream instruction
# "ARMING_SKIPCHK = 8 (skip the GPS arming check)" is therefore translated to
# ARMING_CHECK = 0xFFFFF with the "GPS lock" bit (bit 3, value 8) cleared,
# i.e. every other arming check stays enabled.

# --- Beacon system: disabled, the position now comes over MAVLink ---
BCN_TYPE 0

# --- Visual odometry / external navigation backend ---
# VISO_TYPE 1 selects the MAVLink backend (AP_VisualOdom_MAV), which is the
# one that consumes ODOMETRY (331).  VISO_TYPE 0 (None) disables it, and the
# EKF refuses to arm with EK3_SRC1_POSXY = EXTNAV while it is disabled.
VISO_TYPE 1
# Transport delay between the UWB fix and the EKF fusion, in milliseconds.
VISO_DELAY_MS 50
# Position measurement noise floor, in metres.  ArduPilot derives the
# measurement noise from the covariance of the ODOMETRY message and then
# clamps it to at least this value, so this is what determines the EKF
# measurement variance for a well-behaved UWB solution.  Note that the
# upstream formula squares the (already squared) covariance entries, so the
# derived error is smaller than the real standard deviation; the floor is
# what keeps the EKF from becoming over-confident about the fix.
VISO_POS_M_NSE 0.05
# Velocity measurement noise, in m/s.  Only relevant when velocities are
# actually sent; the node sends position only, so this is left at its default.
VISO_VEL_M_NSE 0.1
# Minimum quality of an accepted message.  0 accepts messages with unknown
# quality, which is what the node sends.
VISO_QUAL_MIN 0

# --- EKF3: use the external navigation system as the primary position source ---
EK3_ENABLE 1
EK2_ENABLE 0
# EK3_SRC1_POSXY: 6 = EXTNAV (external navigation), replacing 4 = BEACON.
EK3_SRC1_POSXY 6
# Height still comes from the barometer, so the node only has to send x/y.
EK3_SRC1_POSZ 1
# The node does not send a velocity estimate, so no velocity source is
# selected.  Setting this to 6 (EXTNAV) would make the EKF fuse the
# velocities of the ODOMETRY message, which are all zero here.
EK3_SRC1_VELXY 0
EK3_SRC1_VELZ 0
EK3_SRC1_YAW 1
AHRS_EKF_TYPE 3

# --- No GPS: this is an indoor setup ---
GPS1_TYPE 0
GPS2_TYPE 0

# --- Serial port used by the MAVLink external navigation link ---
# SerialProtocol_MAVLink = 1.  Set in the defaults file so the serial port is
# opened with the MAVLink protocol from the very first boot; changing
# SERIALx_PROTOCOL at runtime requires the EKF to be reinitialised.
SERIAL1_PROTOCOL 1
SERIAL1_BAUD 115200
# No hardware flow control on the navigation port.
BRD_SER1_RTSCTS 0

# --- Arming checks ---
# ARMING_CHECK is a bitmask; 0 disables every pre-arm check.  The x500
# Gazebo parameter set already does this, and the beacon setup cannot pass
# the GPS lock check anyway (GPS1_TYPE is 0), so the two agree and the
# merged value is 0.  Earlier revisions of the beacon-only parameter file
# used 1048567, which cleared just the GPS lock bit but left the INS,
# compass and RC checks enabled; that is stricter than the x500 baseline
# and not needed here.
ARMING_CHECK 0
